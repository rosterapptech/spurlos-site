---
// Wortmarke-Symbol: ein Blatt Papier, durch das ein Scanner-Balken laeuft –
// dieselbe Bildidee wie das App-Icon (Dokument + roter Suchstrahl), nur in den
// Website-Tokens statt in Icon-Farben.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-hidden="true"
>
  <path
    d="M8 3.5h10l6.5 6.5V27a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 27V5A1.5 1.5 0 0 1 8 3.5Z"
    stroke="var(--mint)"
    stroke-width="2"
    stroke-linejoin="round"
  />
  <path d="M18 3.5V10h6.5" stroke="var(--mint)" stroke-width="2" stroke-linejoin="round" />
  <path
    d="M11 20h10M11 24h6"
    stroke="var(--mint-pale)"
    stroke-width="1.7"
    stroke-linecap="round"
  />
  <rect x="2" y="14.2" width="28" height="2.6" rx="1.3" fill="var(--alert)" opacity="0.9" />
</svg>
