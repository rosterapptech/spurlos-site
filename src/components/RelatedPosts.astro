---
import { getCollection } from 'astro:content';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  currentId: string;
  tags: string[];
}

const { lang, currentId, tags } = Astro.props;
const tr = t(lang);
const prefix = lang === 'de' ? '' : `/${lang}`;

// Thematisch naechste Posts derselben Sprache: sortiert nach Tag-Ueberschneidung,
// bei Gleichstand nach Aktualitaet. Dadurch gibt es immer Ergebnisse, auch wenn
// kein Tag uebereinstimmt (dann einfach die neuesten Artikel).
const related = (await getCollection('blog'))
  .filter((p) => p.data.lang === lang && p.id !== currentId)
  .map((p) => ({
    post: p,
    score: p.data.tags.filter((tag) => tags.includes(tag)).length,
  }))
  .sort(
    (a, b) =>
      b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
  )
  .slice(0, 4)
  .map((s) => s.post);
---

{
  related.length > 0 && (
    <aside class="related" aria-label={tr('blog.related')}>
      <h2>{tr('blog.related')}</h2>
      <div class="related-grid">
        {related.map((p) => (
          <a href={`${prefix}/blog/${p.id}/`} class="card related-card">
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <span class="more">{tr('blog.readmore')}</span>
          </a>
        ))}
      </div>
    </aside>
  )
}

<style>
  .related {
    margin-top: 72px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  .related h2 {
    font-size: 1.35rem;
    margin-bottom: 24px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    color: var(--text);
    transition: border-color 0.2s ease, transform 0.15s ease;
  }
  .related-card:hover {
    text-decoration: none;
    border-color: var(--mint);
    transform: translateY(-3px);
  }
  .related-card h3 {
    font-size: 1.05rem;
    margin: 0 0 8px;
  }
  .related-card p {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    flex-grow: 1;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .more {
    color: var(--mint-pale);
    font-size: 0.85rem;
    margin-top: 12px;
  }
  @media (max-width: 720px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
