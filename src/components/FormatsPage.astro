---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/ui';
import { deepCategories, surfaceExtensions, totalFormatCount } from '../config/formats';
import { formatsPath, FORMATS_SLUG } from '../i18n/formatsPath';
import { slugAlternates } from '../i18n/slugAlternates';
import { formatsBreadcrumb } from '../i18n/breadcrumbs';
import { contact } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const site = Astro.site ?? new URL('https://spurlosapp.com');

// Diese Seite hat pro Sprache einen eigenen Slug – der Default in BaseLayout
// wuerde /en/unterstuetzte-formate/ erzeugen (404). Deshalb explizit.
const alternates = slugAlternates(formatsPath, site);

const copy = {
  de: {
    title: `Unterstützte Formate – ${totalFormatCount} Dateitypen | Spurlos`,
    description: `Alle ${totalFormatCount} Dateitypen, die Spurlos annimmt: Fotos, Videos, Audio, PDF, Office, OpenDocument und iWork mit vollständiger Bereinigung – dazu RAW, Archive, Geodaten und mehr auf Dateisystem-Ebene.`,
    eyebrow: 'Formate',
    h1: 'Unterstützte Formate',
    lede: `Spurlos nimmt ${totalFormatCount} Dateitypen an. Die Analyse ist bei allen kostenlos. Bei den Formaten mit vollständiger Bereinigung entfernt die App die Metadaten im Inneren der Datei; bei allen übrigen die Spuren, die das Dateisystem anhängt.`,
    deepH2: 'Vollständige Bereinigung',
    deepLede:
      'Diese Formate werden vollständig geöffnet: Spurlos liest jedes Metadaten-Feld, zeigt es an und schreibt die Datei ohne diese Felder neu – ohne Bild- oder Videodaten neu zu kodieren.',
    deepNote:
      'Bei diesen Formaten werden eingebettete Metadaten wie GPS-Position, Gerät, Autor und Zeitstempel analysiert und entfernt.',
    carriesLabel: 'Typischer Inhalt',
    proLabel: 'Bereinigung mit Spurlos Pro',
    freeLabel: 'Bereinigung kostenlos',
    surfaceH2: 'Weitere Formate',
    surfaceLede: `Diese ${surfaceExtensions.length} Formate nimmt Spurlos ebenfalls an. Der Dateiinhalt wird Byte für Byte kopiert und nicht verändert; entfernt werden die Spuren, die das Betriebssystem außen an die Datei hängt: die Herkunfts-URL eines Downloads, Tags und Finder-Kommentare, das Quarantäne-Attribut und weitere erweiterte Attribute. Metadaten im Inneren dieser Formate werden weder angezeigt noch entfernt – die App sagt das bei jeder solchen Datei ausdrücklich.`,
    missingH2: 'Format fehlt?',
    missingText:
      'Wenn du ein Format vermisst, schreib uns – die Liste wächst mit den Anfragen.',
  },
  en: {
    title: `Supported formats – ${totalFormatCount} file types | Spurlos`,
    description: `All ${totalFormatCount} file types Spurlos accepts: photos, video, audio, PDF, Office, OpenDocument and iWork with full cleaning — plus RAW, archives, geodata and more at file system level.`,
    eyebrow: 'Formats',
    h1: 'Supported formats',
    lede: `Spurlos accepts ${totalFormatCount} file types. Analysis is free for all of them. For the formats with full cleaning the app removes the metadata inside the file; for all others the traces the file system attaches.`,
    deepH2: 'Full cleaning',
    deepLede:
      'These formats are opened all the way: Spurlos reads every metadata field, shows it to you and rewrites the file without those fields — without re-encoding image or video data.',
    deepNote:
      'For these formats, embedded metadata such as GPS position, device, author and timestamps is analysed and removed.',
    carriesLabel: 'Typically contains',
    proLabel: 'Cleaning with Spurlos Pro',
    freeLabel: 'Cleaning free',
    surfaceH2: 'More formats',
    surfaceLede: `Spurlos accepts these ${surfaceExtensions.length} formats too. The file content is copied byte for byte and never modified; what gets removed are the traces the operating system attaches on the outside: the origin URL of a download, tags and Finder comments, the quarantine attribute and other extended attributes. Metadata inside these formats is neither shown nor removed — the app says so explicitly for every such file.`,
    missingH2: 'Missing a format?',
    missingText: 'If a format is missing, write to us — the list grows with the requests.',
  },
}[lang];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [formatsBreadcrumb(lang, copy.h1, site)],
};
---

<BaseLayout
  lang={lang}
  path={`/${FORMATS_SLUG[lang]}`}
  title={copy.title}
  description={copy.description}
  schema={schema}
  alternates={alternates}
>
  <Header lang={lang} />
  <main class="container formats-page">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.h1}</h1>
    <p class="lede">{copy.lede}</p>

    <h2>{copy.deepH2}</h2>
    <p class="section-lede">{copy.deepLede}</p>

    <div class="cat-list">
      {
        deepCategories.map((cat) => (
          <article class="card cat">
            <header>
              <h3>{cat.label[lang]}</h3>
              <span class={cat.tier === 'pro' ? 'tier pro' : 'tier'}>
                {cat.tier === 'pro' ? copy.proLabel : copy.freeLabel}
              </span>
            </header>
            <p class="exts">{cat.extensions.join(' · ')}</p>
            <p class="carries">
              <strong>{copy.carriesLabel}:</strong> {cat.carries[lang]}
            </p>
          </article>
        ))
      }
    </div>
    <p class="note">{copy.deepNote}</p>

    <h2>{copy.surfaceH2}</h2>
    <p class="section-lede">{copy.surfaceLede}</p>

    <p class="card surface-list exts">{surfaceExtensions.join(' · ')}</p>

    <h2>{copy.missingH2}</h2>
    <p class="section-lede">
      {copy.missingText} <a href={`mailto:${contact.email}`}>{contact.email}</a>
    </p>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .formats-page {
    max-width: 860px;
    padding-block: 60px 96px;
  }
  .formats-page h1 {
    margin-top: 0.2em;
  }
  .formats-page h2 {
    font-size: 1.6rem;
    margin-top: 3rem;
  }
  .section-lede {
    color: var(--text-muted);
    max-width: 68ch;
  }
  .cat-list {
    display: grid;
    gap: 14px;
    margin-top: 28px;
  }
  .cat header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cat h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .tier {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .tier.pro {
    color: var(--mint);
    border-color: var(--mint-deep);
  }
  .exts {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--mint-pale);
    margin: 12px 0 0;
    line-height: 1.7;
  }
  .carries {
    margin: 12px 0 0;
    color: var(--text-muted);
    font-size: 0.93rem;
  }
  .carries strong {
    color: var(--text);
  }
  .note {
    margin-top: 14px;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .surface-list {
    margin-top: 28px;
    color: var(--text-dim);
    line-height: 1.9;
  }
</style>
