---
import { getCollection } from 'astro:content';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const prefix = lang === 'de' ? '' : `/${lang}`;

const LOCALE: Record<Lang, string> = {
  de: 'de-DE',
  en: 'en-GB',
};

const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const fmt = (d: Date) =>
  d.toLocaleDateString(LOCALE[lang], { year: 'numeric', month: 'long', day: 'numeric' });
---

{
  posts.length > 0 && (
    <section class="blog-teaser">
      <div class="container">
        <p class="eyebrow">Blog</p>
        <h2>{tr('home.blog.title')}</h2>
        <div class="teaser-grid">
          {posts.map((p) => (
            <a href={`${prefix}/blog/${p.id}/`} class="card teaser-card">
              <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="more">{tr('blog.readmore')}</span>
            </a>
          ))}
        </div>
        <a href={`${prefix}/blog/`} class="all-link">
          {tr('home.blog.all')}
        </a>
      </div>
    </section>
  )
}

<style>
  .teaser-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
  }
  .teaser-card {
    display: flex;
    flex-direction: column;
    color: var(--text);
    transition: border-color 0.2s ease, transform 0.15s ease;
  }
  .teaser-card:hover {
    text-decoration: none;
    border-color: var(--mint);
    transform: translateY(-3px);
  }
  .teaser-card time {
    color: var(--text-dim);
    font-size: 0.82rem;
  }
  .teaser-card h3 {
    font-size: 1.15rem;
    margin: 10px 0 8px;
  }
  .teaser-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    flex-grow: 1;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .more {
    color: var(--mint-pale);
    font-size: 0.88rem;
    margin-top: 12px;
  }
  .all-link {
    display: inline-block;
    margin-top: 28px;
    color: var(--mint-pale);
  }
  @media (max-width: 720px) {
    .teaser-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
